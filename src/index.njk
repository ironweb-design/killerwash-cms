        <div class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.4.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg></div>
        <div><b>Call or text</b><span><a href="tel:+1{{ site.business.phone_digits }}">{{ site.business.phone_display }}</a></span></div>
      </div>
      <div class="info-row">
        <div class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg></div>
        <div><b>Email</b><span><a href="mailto:{{ site.business.email }}">{{ site.business.email }}</a></span></div>
      </div>
      <div class="info-row">
        <div class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C8.1 2 5 5.1 5 9c0 5.2 7 13 7 13s7-7.8 7-13c0-3.9-3.1-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z"/></svg></div>
        <div><b>Serving</b><span>{{ site.business.serving }}</span></div>
      </div>
      <div class="info-row">
        <div class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm4.2 14.2L11 13V7h1.5v5.3l4.5 2.6-.8 1.3z"/></svg></div>
        <div><b>Hours</b><span>{{ site.business.hours }} &middot; Quotes start at ${{ site.business.quote_start }}</span></div>
      </div>
    </div>

    <form class="qform" id="quoteForm" action="https://formspree.io/f/mojgvylg" method="POST">
      <input type="hidden" name="_subject" value="New quote request from killerpowerwash.com"/>
      <input type="text" name="_gotcha" class="gotcha" tabindex="-1" autocomplete="off" aria-hidden="true"/>
      <div class="row2">
        <div class="field"><label for="f-name">Your Name</label><input id="f-name" name="name" type="text" placeholder="Your name" required/></div>
        <div class="field"><label for="f-phone">Your Phone</label><input id="f-phone" name="phone" type="tel" placeholder="(281) 555-0100" required/></div>
      </div>
      <div class="row2">
        <div class="field"><label for="f-email">Your Email</label><input id="f-email" name="email" type="email" placeholder="you@example.com"/></div>
        <div class="field"><label for="f-address">Service Address</label><input id="f-address" name="address" type="text" placeholder="1234 Maple Dr, Katy" required/></div>
      </div>
      <div class="row2">
        <div class="field"><label for="f-service">Service Needed</label>
          <select id="f-service" name="service">
            <option>Driveway or sidewalk</option>
            <option>Patio or deck</option>
            <option>Trash bins</option>
            <option>Car wash</option>
            <option>Something else</option>
          </select>
        </div>
        <div class="field"><label for="f-date">Preferred Date</label>
          <input id="f-date" name="preferred_date" type="date" required/>
          <p class="avail">Available Tuesday to Thursday and Sunday</p>
          <p class="date-error" id="dateError" role="alert">We are not out on that day. Please pick a Tuesday, Wednesday, Thursday, or Sunday.</p>
        </div>
      </div>
      <div class="field"><label for="f-msg">Message</label><textarea id="f-msg" name="message" rows="3" placeholder="Size of the job, best time to reach you, anything else"></textarea></div>
      <button class="submit" type="submit">Send Message</button>
      <p class="fine">No spam, no obligation. We only use this to send your quote.</p>
      <p class="form-error" id="formError" role="alert">Something went wrong sending your message. Please try again, or text us instead.</p>
    </form>

    <div class="form-success" id="formSuccess" role="status">
      <div class="check">&#10003;</div>
      <h3>Request received</h3>
      <p>Thanks! We will get back to you the same day with your free quote. Need it faster? <a href="sms:+1{{ site.business.phone_digits }}">Text us a photo of the job</a>.</p>
    </div>
  </div>
</section>

</div>

</main>

<footer>
  <p>&copy; 2026 <b>Killer Wash Pressure Washing Services</b>. All rights reserved. &middot; Katy, TX</p>
</footer>

<script src="/assets/app.js"></script>

</body>
</html>
